="1" parent="1"><mxGeometry x="60.0" y="1446" width="232.0" height="52" as="geometry"/></mxCell><mxCell id="out1" value='&lt;b style="font-size:13px"&gt;step_timing.txt&lt;/b&gt;&lt;br&gt;ms per step, every 1,000 steps' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="322.0" y="1446" width="232.0" height="52" as="geometry"/></mxCell><mxCell id="out2" value='&lt;b style="font-size:13px"&gt;final_epoch_action_list.pkl&lt;/b&gt;&lt;br&gt;the moves: this is the controller' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="584.0" y="1446" width="232.0" height="52" as="geometry"/></mxCell><mxCell id="out3" value='&lt;b style="font-size:13px"&gt;Gradient plots&lt;/b&gt;&lt;br&gt;saved once, when a phase ends' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="846.0" y="1446" width="232.0" height="52" as="geometry"/></mxCell><mxCell id="out4" value='&lt;b style="font-size:13px"&gt;output.prof&lt;/b&gt;&lt;br&gt;cProfile of the whole run' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="1108.0" y="1446" width="232.0" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
