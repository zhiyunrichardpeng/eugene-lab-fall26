<mxfile host="app.diagrams.net"><diagram id="workflow" name="Workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1535" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How one run works on update-deprecated-e52" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=26;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.4" width="599.6" height="39.0" as="geometry"/></mxCell><mxCell id="subtitle" value="1 launch  →  up to 8 phases  →  about 37,000 steps per phase  →  every step: look, decide, limit, move, measure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=15;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="63.5" width="776.4" height="22.5" as="geometry"/></mxCell><mxCell id="legend_launch" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="978.0" y="24" width="16.0" height="14" as="geometry"/></mxCell><mxCell id="legend_launch_t" value="Launch scripts and Trainer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1002.0" y="22.8" width="169.8" height="18.0" as="geometry"/></mxCell><mxCell id="legend_evaluator" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCE9FB;strokeColor=#2F6FDB;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spaci