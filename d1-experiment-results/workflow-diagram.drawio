ed=1;" vertex="1" parent="1"><mxGeometry x="1208.0" y="46" width="16.0" height="14" as="geometry"/></mxCell><mxCell id="legend_file_t" value="Files" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1232.0" y="44.8" width="51.6" height="18.0" as="geometry"/></mxCell><mxCell id="s0" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="40.0" y="105" width="1320.0" height="125" as="geometry"/></mxCell><mxCell id="s0_t" value="Where this run sits in the whole method" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=15;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="113.5" width="311.1" height="22.5" as="geometry"/></mxCell><mxCell id="s0_n" value="(from the paper)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="368.0" y="115.7" width="118.8" height="19.5" as="geometry"/></mxCell><mxCell id="ctx0" value='&lt;b style="font-size:14px"&gt;Two poses from the artist&lt;/b&gt;&lt;br&gt;a start pose and a target pose' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B6BEC8;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60.0" y="145" width="224.0" height="70" as="geometry"/></mxCell><mxCell id="ctx1" value='&lt;b style="font-size:14px"&gt;THIS RUN&lt;/b&gt;&lt;br&gt;search for the small moves that&lt;br&gt;take the muscles to the target' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F6FDB;strokeColor=#1F4FA3;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="324.0" y="145" width="224.0" height="70" as="geometry"/></mxCell><mxCell id="ctx_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ctx0" target="ctx1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx2" value='&lt;b style="font-size:14px"&gt;Transition table&lt;/b&gt;&lt;br&gt;the moves are stored as a&lt;br&gt;reusable controller' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B6BEC8;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="588.0" y="145" width="224.0" height="70" as="geometry"/></mxCell><mxCell id="ctx_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ctx1" target="ctx2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx3" value='&lt;b style="font-size:14px"&gt;Compose&lt;/b&gt;&lt;br&gt;chain controllers, with overlap,&lt;br&gt;into speech and expressions' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B6BEC8;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="852.0" y="145" width="224.0" height="70" as="geometry"/></mxCell><mxCell id="ctx_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ctx2" target="ctx3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx4" value='&lt;b style="font-size:14px"&gt;Skin&lt;/b&gt;&lt;br&gt;muscles and bones drive&lt;br&gt;the skin on top' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B6BEC8;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1116.0" y="145" width="224.0" height="70" as="geometry"/></mxCell><mxCell id="ctx_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ctx3" target="ctx4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="40.0" y="250" width="1320.0" height="265" as="geometry"/></mxCell><mxCell id="s1_t" value="1   Launch" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="259.3" width="110.0" height="25.5" as="geometry"/></mxCell><mxCell id="s1_n" value="happens once, on the Windows lab machine" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="160.0" y="263.7" width="277.8" height="19.5" as="geometry"/></mxCell><mxCell id="bat" value='&lt;b style="font-size:14px"&gt;run_d1_b99.bat&lt;/b&gt;&lt;br&gt;sets the stop thresholds&lt;br&gt;(0.1 = within 10% of the&lt;br&gt;start distance) and the step cap' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="400.0" y="298" width="220.0" height="100" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b style="font-size:14px"&gt;d1-adhoc-for-b99.py&lt;/b&gt;&lt;br&gt;runs under mayapy, wrapped&lt;br&gt;in cProfile (output.prof)' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="640.0" y="298" width="220.0" height="100" as="geometry"/></mxCell><mxCell id="launch_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="bat" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value='&lt;b style="font-size:14px"&gt;a2_fromFrameGetDeltaB.py&lt;/b&gt;&lt;br&gt;loads the poses, measures the&lt;br&gt;start distances, builds the&lt;br&gt;env, Evaluator and Trainer' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880.0" y="298" width="220.0" height="100" as="geometry"/></mxCell><mxCell id="launch_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="d1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trainer" value='&lt;b style="font-size:14px"&gt;Trainer.train()&lt;/b&gt;&lt;br&gt;runs the phases&lt;br&gt;one after another' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1120.0" y="298" width="220.0" height="100" as="geometry"/></mxCell><mxCell id="launch_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="a2" target="trainer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="in_t" value="Start here:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="330.7" width="90.8" height="19.5" as="geometry"/></mxCell><mxCell id="in_t2" value="double-click the .bat, or run it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="351.8" width="182.3" height="18.0" as="geometry"/></mxCell><mxCell id="in_t3" value="from PowerShell" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="368.8" width="115.8" height="18.0" as="geometry"/></mxCell><mxCell id="start_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" target="bat"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="348" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="files_t" value="Inputs a2 loads:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="447.7" width="122.6" height="19.5" as="geometry"/></mxCell><mxCell id="f_pose" value='&lt;b style="font-size:13px"&gt;Poses  (database/)&lt;/b&gt;&lt;br&gt;dataV22.py = target pose&lt;br&gt;dataV22_for_rest_adhoc.py = start' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="400.0" y="428" width="220.0" height="70" as="geometry"/></mxCell><mxCell id="f_scene" value='&lt;b style="font-size:13px"&gt;Maya scene&lt;/b&gt;&lt;br&gt;the head with its muscles&lt;br&gt;and joints (Ziva)' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="640.0" y="428" width="220.0" height="70" as="geometry"/></mxCell><mxCell id="f_skin" value='&lt;b style="font-size:13px"&gt;Skin weights  (automation/)&lt;/b&gt;&lt;br&gt;*.json: which joint pulls which&lt;br&gt;vertex, for the gradient formula' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A96A3;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="880.0" y="428" width="220.0" height="70" as="geometry"/></mxCell><mxCell id="f_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="f_pose" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="413"/><mxPoint x="990" y="413"/></Array></mxGeometry></mxCell><mxCell id="f_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="f_scene" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="413"/><mxPoint x="990" y="413"/></Array></mxGeometry></mxCell><mxCell id="f_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="f_skin" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="40.0" y="540" width="1320.0" height="150" as="geometry"/></mxCell><mxCell id="s2_t" value="2   Phase loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="549.3" width="139.5" height="25.5" as="geometry"/></mxCell><mxCell id="s2_n" value="Trainer: up to 8 phases. Each phase is one call of Evaluator.run_evaluation(phase, payload)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="196.0" y="553.7" width="560.8" height="19.5" as="geometry"/></mxCell><mxCell id="trainer_e" value="for each phase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.9015;entryY=0.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="trainer" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph0" value='&lt;b style="font-size:12px"&gt;Phase 1&lt;/b&gt;&lt;br&gt;Neutral → N' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCE9FB;strokeColor=#2F6FDB;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="63.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph1" value='&lt;b style="font-size:12px"&gt;Phase 2&lt;/b&gt;&lt;br&gt;N → AA' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="225.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph0" target="ph1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph2" value='&lt;b style="font-size:12px"&gt;Phase 3&lt;/b&gt;&lt;br&gt;AA → T' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="387.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph1" target="ph2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph3" value='&lt;b style="font-size:12px"&gt;Phase 4&lt;/b&gt;&lt;br&gt;T → IY' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="549.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph2" target="ph3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph4" value='&lt;b style="font-size:12px"&gt;Phase 5&lt;/b&gt;&lt;br&gt;IY → V' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="711.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph3" target="ph4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph5" value='&lt;b style="font-size:12px"&gt;Phase 6&lt;/b&gt;&lt;br&gt;V → N' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="873.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph4" target="ph5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph6" value='&lt;b style="font-size:12px"&gt;Phase 7&lt;/b&gt;&lt;br&gt;N → Y' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1035.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph5" target="ph6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph7" value='&lt;b style="font-size:12px"&gt;Phase 8&lt;/b&gt;&lt;br&gt;Y → UW' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1197.0" y="585" width="140.0" height="50" as="geometry"/></mxCell><mxCell id="ph_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph6" target="ph7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2_note1" value="Phase 1's target is whatever is in dataV22.py. Phases 2 to 8 are fixed in evaluator.py." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225.0" y="646.8" width="488.0" height="18.0" as="geometry"/></mxCell><mxCell id="s2_note2" value="Each arrow is the payload: the pose a phase ends in is the pose the next one starts from." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225.0" y="663.8" width="503.3" height="18.0" as="geometry"/></mxCell><mxCell id="s3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="40.0" y="715" width="1320.0" height="400" as="geometry"/></mxCell><mxCell id="s3_t" value="3   Step loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="724.3" width="126.8" height="25.5" as="geometry"/></mxCell><mxCell id="s3_n" value="inside one phase, repeated about 36,800 times for Neutral → N" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="182.0" y="728.7" width="389.0" height="19.5" as="geometry"/></mxCell><mxCell id="zoom_e" value="zoom into one phase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;dashed=1;entryX=0.0705;entryY=0.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="ph0" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st1" value='&lt;b style="font-size:15px"&gt;1   Look&lt;/b&gt;&lt;br&gt;Read the observation: where&lt;br&gt;the joints and the sampled&lt;br&gt;vertices are now, and where&lt;br&gt;the target pose wants them.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCE9FB;strokeColor=#2F6FDB;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60.0" y="778" width="236.0" height="160" as="geometry"/></mxCell><mxCell id="st2" value='&lt;b style="font-size:15px"&gt;2   Decide&lt;/b&gt;&lt;br&gt;Work out which way to move.&lt;br&gt;Lips, ooc_l, ooc_r, frontalis:&lt;br&gt;a formula (skinning + Adam).&lt;br&gt;Jaw: a trial rotation in Maya,&lt;br&gt;refreshed every 10 steps.&lt;br&gt;Out: one action, 3,603 numbers.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCE9FB;strokeColor=#2F6FDB;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="316.0" y="778" width="236.0" height="160" as="geometry"/></mxCell><mxCell id="st_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st3" value='&lt;b style="font-size:15px"&gt;3   Limit&lt;/b&gt;&lt;br&gt;env.step clips the action.&lt;br&gt;Lips: a small cap that eases in.&lt;br&gt;Jaw: an anatomical speed curve,&lt;br&gt;halved for the last 15%.&lt;br&gt;Finished tissues are frozen.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDF3EA;strokeColor=#1E8E63;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="572.0" y="778" width="236.0" height="160" as="geometry"/></mxCell><mxCell id="st_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st4" value='&lt;b style="font-size:15px"&gt;4   Move&lt;/b&gt;&lt;br&gt;Maya moves only the joints&lt;br&gt;that changed and deforms&lt;br&gt;the muscle meshes.&lt;br&gt;Read sampled vertices back:&lt;br&gt;jaw every step, the others only&lt;br&gt;when their own joints moved.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCE9D2;strokeColor=#C7751A;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="828.0" y="778" width="236.0" height="160" as="geometry"/></mxCell><mxCell id="st_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st5" value="&lt;b style=&quot;font-size:15px&quot;&gt;5   Measure&lt;/b&gt;&lt;br&gt;Distance from each tissue's&lt;br&gt;sampled vertices to its target:&lt;br&gt;lips, jaw, ooc_l, ooc_r,&lt;br&gt;frontalis." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DDF3EA;strokeColor=#1E8E63;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1084.0" y="778" width="236.0" height="160" as="geometry"/></mxCell><mxCell id="st_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="br1" style="endArrow=none;html=1;rounded=0;strokeColor=#52606D;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="948.0" as="sourcePoint"/><mxPoint x="552.0" y="948.0" as="targetPoint"/><Array as="points"><mxPoint x="60.0" y="954.0"/><mxPoint x="552.0" y="954.0"/></Array></mxGeometry></mxCell><mxCell id="br1_t" value="gradients: about 4 ms" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="235.6" y="958.8" width="140.8" height="18.0" as="geometry"/></mxCell><mxCell id="br2" style="endArrow=none;html=1;rounded=0;strokeColor=#52606D;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="572.0" y="948.0" as="sourcePoint"/><mxPoint x="1320.0" y="948.0" as="targetPoint"/><Array as="points"><mxPoint x="572.0" y="954.0"/><mxPoint x="1320.0" y="954.0"/></Array></mxGeometry></mxCell><mxCell id="br2_t" value="env.step: about 47 ms of the 52 ms a step takes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="718.0" y="958.8" width="284.0" height="18.0" as="geometry"/></mxCell><mxCell id="dec" value="All five within&lt;br&gt;10% of their start&lt;br&gt;distance?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DDF3EA;strokeColor=#1E8E63;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1092.0" y="990" width="220.0" height="104" as="geometry"/></mxCell><mxCell id="dec_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;" edge="1" parent="1" source="st5" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dec_no" value="not yet: next step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="dec" target="st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1342" y="1042"/><mxPoint x="1342" y="760"/><mxPoint x="178" y="760"/></Array></mxGeometry></mxCell><mxCell id="done" value='&lt;b style="font-size:14px"&gt;Phase done&lt;/b&gt;&lt;br&gt;Save the moves, logs and plots.&lt;br&gt;Hand the end pose to the next phase.' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6EAF0;strokeColor=#5B6B7C;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="640.0" y="1004" width="340.0" height="76" as="geometry"/></mxCell><mxCell id="dec_yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52606D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;fontColor=#52606D;labelBackgroundColor=#F6F7F9;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;" edge="1" parent="1" source="dec" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cost_n1" value="Timings are from the 11/19 full run," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1016.8" width="218.9" height="18.0" as="geometry"/></mxCell><mxCell id="cost_n2" value="before the lip read was skipped" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1033.8" width="193.0" height="18.0" as="geometry"/></mxCell><mxCell id="cost_n3" value="(step 4 used to read the lips every step)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="1050.8" width="242.2" height="18.0" as="geometry"/></mxCell><mxCell id="s4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#D5DAE1;" vertex="1" parent="1"><mxGeometry x="40.0" y="1140" width="1320.0" height="240" as="geometry"/></mxCell><mxCell id="s4_t" value="What one phase looks like in time" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="1149.3" width="297.9" height="25.5" as="geometry"/></mxCell><mxCell id="s4_n" value="Neutral → N, 11/19 full run: 36,782 steps, 33.6 minutes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontFamily=Helvetica;fontColor=#52606D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="372.0" y="1153.7" width="348.4" height="19.5" as="geometry"/></mxCell><mxCell id="tl_lips" value="Lips" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="1216.6" width="54.3" height="21.0" as="geometry"/></mxCell><mxCell id="tl_jaw" value="Jaw" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=14;fontFamily=Helvetica;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="1276.6" width="55.0" height="21.0" as="geometry"/></mxCell><mxCell id="tl_l1" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F6FDB;strokeColor=#1F4FA3;strokeWidth=1.5;fontColor=#1F2933;fo